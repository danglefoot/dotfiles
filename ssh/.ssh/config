# Used by the `dev` fish function. FQDN so it resolves via OPNsense DNS both on
# the home LAN and over the WireGuard VPN (a bare name needs a search domain).
Host devbox
    HostName devbox.buttcode.com
    User colin

# IgnoreUnknown keeps Linux OpenSSH from choking on the macOS-only UseKeychain
Host *
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
    UseKeychain yes
